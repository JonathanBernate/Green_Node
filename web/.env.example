# Copiar a .env.local. Solo variables PÚBLICAS: nunca poner secretos aquí (se incrustan en el bundle).

# Backend REST (Laravel). Por defecto http://localhost:8000
VITE_API_URL=http://localhost:8000

# true (por defecto): contenedores, red y reportes salen de src/mocks → "DATOS DE SIMULACIÓN".
# false: se consumen los endpoints del backend (ver docs/api.md).
VITE_USE_MOCK_DATA=true

# Servicio de clasificación en vivo (realtime/). Vacío = usa el proxy /live de Vite.
# VITE_LIVE_API_URL=https://ia.example.com
